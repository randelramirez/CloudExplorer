<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Cloud Explorer</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.cloudexplorer</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>CloudExplorer</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Explore AWS and Azure resources from one desktop application.</Description>

    <!-- Uno.Resizetizer turns this source pair into the Windows executable icon,
         macOS ICNS, Linux/Snap launcher image, and runtime desktop window icon. -->
    <UnoIconBackgroundFile>Assets/Icons/icon.svg</UnoIconBackgroundFile>
    <UnoIconForegroundFile>Assets/Icons/icon_foreground.svg</UnoIconForegroundFile>
    <UnoIconForegroundScale>0.88</UnoIconForegroundScale>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
