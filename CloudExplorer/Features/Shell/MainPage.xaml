<Page
    x:Class="CloudExplorer.Features.Shell.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CloudExplorer.Features.ResourceExplorer"
    Loaded="PageLoaded"
    Background="{ThemeResource PageBackgroundBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border
        Padding="18,12"
        Background="{ThemeResource ShellBackgroundBrush}"
        BorderBrush="{ThemeResource BorderBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="12" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Width="40"
            Height="40"
            Background="{ThemeResource SurfaceMutedBrush}"
            CornerRadius="12">
          <TextBlock
              Text="☁"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="22"
              Foreground="{ThemeResource AzureAccentBrush}" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock
              Text="Cloud Explorer"
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="{ThemeResource TextPrimaryBrush}" />
          <TextBlock
              Text="AWS and Azure resources, using your local CLI sessions"
              FontSize="11"
              Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>

        <ToggleSwitch
            Grid.Column="2"
            Header="Dark mode"
            IsOn="{Binding IsDarkMode, Mode=TwoWay}"
            Toggled="ThemeToggled" />

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            Spacing="12"
            AutomationProperties.Name="Provider view">
          <TextBlock
              Text="Provider view"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{ThemeResource TextPrimaryBrush}" />
          <RadioButton
              x:Name="BothViewOption"
              Content="Both"
              GroupName="ProviderViewMode"
              IsChecked="True"
              Checked="ProviderViewOptionChecked"
              Tag="Both"
              AutomationProperties.HelpText="Show AWS and Azure side by side" />
          <RadioButton
              x:Name="AwsViewOption"
              Content="AWS"
              GroupName="ProviderViewMode"
              Checked="ProviderViewOptionChecked"
              Tag="Aws"
              AutomationProperties.HelpText="Show only AWS" />
          <RadioButton
              x:Name="AzureViewOption"
              Content="Azure"
              GroupName="ProviderViewMode"
              Checked="ProviderViewOptionChecked"
              Tag="Azure"
              AutomationProperties.HelpText="Show only Azure" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid
        x:Name="ProviderWorkspace"
        Grid.Row="1"
        ColumnSpacing="1"
        Background="{ThemeResource BorderBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <views:ProviderPane
          x:Name="AwsProviderPane"
          Grid.Column="0"
          DataContext="{Binding Aws}"
          ProviderName="Amazon Web Services"
          ProviderInitial="A"
          AccentBrush="{ThemeResource AwsAccentBrush}"
          TintBrush="{ThemeResource AwsTintBrush}"
          AccentForegroundBrush="{ThemeResource AwsOnAccentBrush}" />
      <views:ProviderPane
          x:Name="AzureProviderPane"
          Grid.Column="1"
          DataContext="{Binding Azure}"
          ProviderName="Microsoft Azure"
          ProviderInitial="Az"
          AccentBrush="{ThemeResource AzureAccentBrush}"
          TintBrush="{ThemeResource AzureTintBrush}"
          AccentForegroundBrush="{ThemeResource AzureOnAccentBrush}" />
    </Grid>
  </Grid>
</Page>
